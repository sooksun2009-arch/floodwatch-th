# ---------------------------------------------------------------- core
# Railway supplies DATABASE_URL automatically when a Postgres service is attached.
# Leave unset locally to use a SQLite file.
# DATABASE_URL=postgresql://user:pass@host:5432/floodwatch

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# ---------------------------------------------------------------- behaviour
# How long a report stays on the map without being re-confirmed.
REPORT_TTL_HOURS=12
# Disputes that pull an approved report back into the moderation queue.
AUTO_FLAG_DISPUTES=3
# Reports per hour from one anonymous IP.
ANON_REPORT_LIMIT=5
CHAT_LIMIT_PER_HOUR=60
# false = anonymous reports appear on the map immediately (closed deployments only)
REQUIRE_MODERATION=true
ALLOW_ANONYMOUS_REPORTS=true

# ---------------------------------------------------------------- routing
# Any OSRM-compatible server. The public demo host is rate limited and is NOT
# for production — self-host osrm-backend with a Thailand OSM extract.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SEC=8

# Optional. Adds routing that actively steers around flooded areas.
# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# No-go radius drawn around each impassable report, in metres.
AVOID_RADIUS_M=120
# Minimum level worth a detour: puddle|shallow|deep|severe|closed
AVOID_MIN_LEVEL=deep

# How close to the route a report counts as "on my way", in metres.
ROUTE_CORRIDOR_M=150
ROUTE_CAMERA_CORRIDOR_M=600
ROUTE_MIN_CONFIDENCE=0.25

# ---------------------------------------------------------------- geocoding
GEOCODE_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real, identifying User-Agent. Put a
# contact address you actually read here.
HTTP_USER_AGENT=FloodWatchTH/1.0 (flood alert app; contact: you@example.com)

# ---------------------------------------------------------------- chatbot
# The chatbot answers from database facts with no external calls by default.
# Turning this on only lets Claude rephrase those same facts — it can never
# introduce a road or a depth that is not already in the data.
CHAT_LLM_ENABLED=false
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------- water gauges
# Live canal/river levels from the National Hydroinformatics Data Center.
# Needs no key and no account — this is the one real data source that works
# out of the box.
THAIWATER_BASE_URL=https://api-v3.thaiwater.net
STATION_TIMEOUT_SEC=30
# A reading older than this is shown as stale rather than current.
STATION_STALE_HOURS=6
# Pull readings at boot so a fresh deploy has live data immediately.
SYNC_STATIONS_ON_START=true
# The app re-syncs itself on this interval, so no external cron is needed.
# 0 = sync once at boot only. POST /api/stations/sync still works for a manual
# refresh from the admin screen.
STATION_SYNC_INTERVAL_MIN=15

# A camera frame older than this is labelled "not live". Agency snapshot
# endpoints keep returning HTTP 200 long after the picture stops updating.
CAMERA_STALE_MINUTES=90

# ---------------------------------------------------------------- uploads
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=8
MAX_IMAGE_PX=1600

# ---------------------------------------------------------------- seed
SEED_ADMIN_USERNAME=admin
# CHANGE THIS before the first boot — it creates the admin account.
SEED_ADMIN_PASSWORD=admin1234
# false in production: skips the sample cameras and sample flood points.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------- frontend
# Build-time only. Leave empty to use raster OpenStreetMap tiles with no key.
# For real traffic, use a tile provider you have an agreement with.
VITE_MAP_STYLE=
